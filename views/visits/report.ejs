<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Job report #<%= visit.id %> — <%= visit.property_name %></title>
<style>
  body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #1d2620; margin: 0; background: #fff; }
  .wrap { max-width: 800px; margin: 0 auto; padding: 32px 24px; }
  header { border-bottom: 3px solid #14532d; padding-bottom: 16px; margin-bottom: 24px; }
  h1 { font-size: 1.4rem; margin: 0; color: #14532d; }
  h2 { font-size: 1rem; margin: 28px 0 8px; color: #14532d; border-bottom: 1px solid #e6e4dc; padding-bottom: 4px; }
  .meta { color: #707b72; font-size: 0.9rem; margin-top: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  td, th { text-align: left; padding: 6px 8px; border-bottom: 1px solid #eee; vertical-align: top; }
  th { width: 200px; color: #707b72; font-weight: 600; }
  .pill { display: inline-block; padding: 1px 10px; border-radius: 999px; font-size: 0.78rem; background: #e3f5ea; color: #15803d; }
  .photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  figure { margin: 0; }
  img { width: 100%; border-radius: 8px; border: 1px solid #e6e4dc; }
  figcaption { font-size: 0.78rem; color: #707b72; margin-top: 4px; }
  .stamp { background: #14532d; color: #fff; padding: 1px 8px; border-radius: 4px; font-size: 0.74rem; }
  .scope { border: 1px solid #e6e4dc; border-radius: 8px; padding: 10px 12px; margin: 10px 0; page-break-inside: avoid; }
  .scope .photos { margin-top: 8px; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
  .ok { color: #15803d; font-weight: 700; } .no { color: #b45309; font-weight: 700; }
  .comment { border-left: 3px solid #e6e4dc; padding: 4px 12px; margin: 8px 0; }
  footer { margin-top: 40px; color: #707b72; font-size: 0.78rem; border-top: 1px solid #e6e4dc; padding-top: 12px; }
  @media print { .no-print { display: none; } }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>🌱 Job completion report — #<%= visit.id %></h1>
    <p class="meta"><%= visit.property_name %>, <%= visit.address %> · <%= visit.scheduled_date %></p>
  </header>

  <h2>Job details</h2>
  <table>
    <tr><th>Site</th><td><%= visit.property_name %> — <%= visit.address %>
      <% if (visit.lots != null) { %> (<%= visit.lots %> lots)<% } %></td></tr>
    <% if (visit.contact_name) { %><tr><th>Site contact</th><td><%= visit.contact_name %></td></tr><% } %>
    <tr><th>Gardener</th><td><%= visit.gardener_name || 'Unassigned' %></td></tr>
    <tr><th>Status</th><td><span class="pill"><%= visit.status === 'approved' ? 'approved for payment' : visit.status.replace('_',' ') %></span>
      <% if (visit.approved_at) { %> <span class="meta">by <%= visit.approved_by_name || 'admin' %> on <%= visit.approved_at %> UTC</span><% } %></td></tr>
    <tr><th>Scheduled date</th><td><%= visit.scheduled_date %><% if (visit.time_window) { %> · <%= visit.time_window %><% } %></td></tr>
    <% if (visit.started_at) { %><tr><th>Started</th><td><%= visit.started_at %> UTC</td></tr><% } %>
    <% if (visit.finished_at) { %><tr><th>Completed</th><td><strong><%= visit.finished_at %> UTC</strong></td></tr><% } %>
    <% if (visit.duration_minutes != null) { %><tr><th>Time on site</th><td><%= visit.duration_minutes %> minutes</td></tr><% } %>
    <% if (visit.notes) { %><tr><th>Notes</th><td><%= visit.notes %></td></tr><% } %>
    <% if (job) { %>
      <tr><th>Recurring schedule</th><td><%= job.frequency %> · <%= job.contract_years %>-year contract
        (<%= job.start_date %> → <%= job.end_date %>) · default gardener: <%= job.default_gardener_name || '—' %></td></tr>
    <% } %>
  </table>

  <% if (checks.length) { %>
  <h2>Scope of duties (<%= checks.filter(c => c.done).length %>/<%= checks.length %> done)</h2>
  <% checks.forEach((c, i) => { %>
    <div class="scope">
      <div class="scope-head">
        <span class="<%= c.done ? 'ok' : 'no' %>"><%= c.done ? '✔' : '✘' %></span>
        <strong><%= i + 1 %>. <%= c.title %></strong>
        <% if (c.checked_at) { %><span class="meta"> · <%= c.checked_by_name || '' %> · <%= c.checked_at %> UTC</span><% } %>
      </div>
      <% if (c.comment) { %><div class="comment">💬 <%= c.comment %></div><% } %>
      <% if (c.photos.length) { %>
      <div class="photos">
        <% c.photos.forEach(ph => { %>
          <figure><img src="<%= photoSrc(ph) %>" alt="<%= c.title %>">
            <figcaption><span class="stamp">📅 <%= ph.created_at %> UTC</span></figcaption></figure>
        <% }) %>
      </div>
      <% } %>
    </div>
  <% }) %>
  <% } %>

  <% if (tasks.length) { %>
  <h2>Tasks (<%= tasks.filter(t => t.status === 'done').length %>/<%= tasks.length %> done)</h2>
  <table>
    <% tasks.forEach(t => { %>
      <tr><th><%= t.title %></th><td><span class="pill"><%= t.status.replace('_',' ') %></span>
        <% if (t.description) { %> — <%= t.description %><% } %></td></tr>
    <% }) %>
  </table>
  <% } %>

  <% if (gpsPoints.length) { %>
  <h2>GPS log</h2>
  <table>
    <% gpsPoints.forEach(g => { %>
      <tr><th><%= g.kind %></th><td><%= g.lat.toFixed(5) %>, <%= g.lng.toFixed(5) %> · <%= g.recorded_at %> UTC</td></tr>
    <% }) %>
  </table>
  <% } %>

  <% if (comments.length) { %>
  <h2>Comments</h2>
  <% comments.forEach(c => { %>
    <div class="comment"><strong><%= c.author_name %></strong>
      <span class="meta">(<%= c.author_role %>) · <%= c.created_at %> UTC</span><br><%= c.body %></div>
  <% }) %>
  <% } %>

  <% const scopeIds = new Set(checks.flatMap(c => c.photos.map(p => p.id))); %>
  <% const otherPhotos = photos.filter(ph => !scopeIds.has(ph.id)); %>
  <h2><%= checks.length ? 'Other photos' : 'Photos' %> (<%= otherPhotos.length %>)</h2>
  <% if (!otherPhotos.length) { %><p class="meta">No <%= checks.length ? 'other ' : '' %>photos were uploaded for this job.</p><% } %>
  <div class="photos">
    <% otherPhotos.forEach(ph => { %>
      <figure>
        <img src="<%= photoSrc(ph) %>" alt="<%= ph.caption || ph.filename %>">
        <figcaption><span class="stamp">📅 <%= ph.created_at %> UTC</span>
          <% if (ph.caption) { %> · <%= ph.caption %><% } %> · by <%= ph.uploader_name %></figcaption>
      </figure>
    <% }) %>
  </div>

  <footer>Generated by GardeningMgt on <%= generatedAt %> UTC.</footer>
  <p class="no-print"><button onclick="window.print()">Print / save as PDF</button></p>
</div>
</body>
</html>
